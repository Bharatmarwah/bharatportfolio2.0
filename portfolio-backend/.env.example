# Copy to .env and fill in real values. .env is git-ignored - never commit it.

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/portfolio_db
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# --- Supabase / PostgreSQL instead of local MySQL ---------------------------
# Supabase's direct host (db.<ref>.supabase.co) is IPv6-only, so use the
# Supavisor pooler host for your project's region (Dashboard -> Connect ->
# Session pooler). Session mode uses port 5432 and works with Hibernate; the
# transaction pooler on 6543 needs prepared-statement caching disabled.
#
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
# SPRING_DATASOURCE_PASSWORD=<database password>

SERVER_PORT=8080

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200

# Dev-only. Use Flyway/Liquibase migrations instead of letting Hibernate own the schema.
SPRING_JPA_HIBERNATE_DDL_AUTO=update

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_SSL_ENABLE=false

# Required in the X-Admin-Key header on every /v1 request that is not annotated
# @PublicEndpoint. If blank the server rejects protected requests with 503.
ADMIN_API_KEY=

# Inbox that receives contact-form notifications. Defaults to MAIL_USERNAME if unset.
MAIL_NOTIFICATION_TO=